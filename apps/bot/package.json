{
  "name": "protein-price-bot",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute protein-price-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute protein-price-db --remote --file=./schema.sql",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20250801.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.123.0"
  }
}
